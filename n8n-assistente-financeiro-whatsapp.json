    {
      "parameters": {
        "jsCode": "// Preparar resposta para Evolution API\nconst inputData = $input.all()[0].json;\nconst originalMessage = $('Processar Mensagem').all()[0].json;\n\nlet responseText = '';\n\n// Determinar a resposta baseada no resultado da API\nif (inputData.message) {\n  responseText = inputData.message;\n} else if (inputData.response) {\n  responseText = inputData.response;\n} else if (inputData.error) {\n  responseText = `❌ Erro: ${inputData.error}`;\n} else {\n  responseText = '❌ Desculpe, não consegui processar sua solicitação.';\n}\n\n// Preparar payload para Evolution API\nconst evolutionPayload = {\n  to: `whatsapp:${originalMessage.phone_number}`,\n  text: {\n    body: responseText\n  }\n};\n\nreturn [{ json: evolutionPayload }];"
      },

    {
      "parameters": {
        "jsCode": "// Extrair dados da mensagem do WhatsApp via Evolution API\nconst webhookData = $input.all()[0].json.body;\n\n// Verificar formato da Evolution API\nif (!webhookData.data || !webhookData.data.message) {\n  return [{ json: { error: 'Formato de webhook Evolution inválido' } }];\n}\n\nconst message = webhookData.data.message;\nconst messageInfo = webhookData.data;\n\nconst phoneNumber = message.key.remoteJid.replace('@s.whatsapp.net', '');\nconst messageText = message.message?.conversation || message.message?.extendedTextMessage?.text || '';\nconst messageId = message.key.id;\nconst timestamp = message.messageTimestamp;\n\n// Processar o texto da mensagem\nlet commandType = 'registro'; // padrão\nlet processedData = {\n  phone_number: phoneNumber,\n  message_text: messageText,\n  message_id: messageId,\n  timestamp: timestamp,\n  command_type: 'registro'\n};\n\n// Verificar se é um comando especial\nif (messageText.startsWith('#dia')) {\n  processedData.command_type = 'consulta_dia';\n} else if (messageText.startsWith('#mes')) {\n  processedData.command_type = 'consulta_mes';\n} else if (messageText.startsWith('#conselho')) {\n  processedData.command_type = 'conselho';\n} else if (messageText.toLowerCase().includes('ajuda') || messageText.toLowerCase().includes('help')) {\n  processedData.command_type = 'ajuda';\n} else {\n  // Tentar extrair dados do gasto\n  // Formato esperado: \"Descrição valor categoria\"\n  const parts = messageText.split(' ');\n  if (parts.length >= 3) {\n    // Última palavra é categoria\n    const categoria = parts[parts.length - 1];\n    // Penúltima é valor\n    const valor = parts[parts.length - 2];\n    // Resto é descrição\n    const descricao = parts.slice(0, -2).join(' ');\n    \n    processedData.descricao = descricao;\n    processedData.valor = valor;\n    processedData.categoria = categoria;\n    processedData.command_type = 'registro';\n  } else {\n    // Se não conseguir extrair, tratar como ajuda\n    processedData.command_type = 'ajuda';\n  }\n}\n\nreturn [{ json: processedData }];"
      },

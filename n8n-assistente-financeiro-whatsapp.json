        "jsCode": "// Log de erro\nconst error = $input.all()[0].json;\nconsole.error('Erro no fluxo:', error);\n\n// Tentar enviar mensagem de erro para o usuário\nconst originalMessage = $('Processar Mensagem').all()[0].json;\n\nconst errorPayload = {\n  to: `whatsapp:${originalMessage.phone_number}`,\n  text: {\n    body: \"❌ Desculpe, ocorreu um erro interno. Tente novamente em alguns minutos.\"\n  }\n};\n\nreturn [{ json: errorPayload }];"
      },
